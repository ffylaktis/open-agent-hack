# ---------------------------------------------------------------------------
# Open Agent Hackathon 2026 — environment settings
# Copy this file to `.env` and fill in the real values. `.env` is gitignored.
# Keep all three MODEL_* values from the SAME route (Meterless OR NVIDIA).
# ---------------------------------------------------------------------------

# --- DATA: Zetaris (local Docker install) ---
ZETARIS_REST_URL=http://localhost:8888/api/v1.0
ZETARIS_ORG_ID=1
ZETARIS_API_KEY=your-zetaris-api-key
ZETARIS_USERNAME=your-sign-in-email
ZETARIS_PASSWORD=your-password

# --- POWER: Nemotron route used by smoke_test.py ---
# Pick ONE route and use its address + key + model id together:
#   Route A (Meterless Nightshift):  MODEL_BASE_URL=http://127.0.0.1:8088/v1
#   Route B (NVIDIA free API):       MODEL_BASE_URL=https://integrate.api.nvidia.com/v1
MODEL_BASE_URL=provider-address-for-your-route
MODEL_API_KEY=your-meterless-or-nvapi-key
NEMOTRON_MODEL=the-nemotron-model-id-for-your-route

# --- POWER: Meterless Nightshift (what your app calls at runtime) ---
METERLESS_BASE_URL=http://127.0.0.1:8088/v1
METERLESS_RUNTIME_TOKEN=your-nightshift-runtime-token
METERLESS_MODEL=meterless/auto
